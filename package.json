{
  "name": "pi-review",
  "version": "0.1.0",
  "description": "Code Review Agent built on the pi framework — resumable, budget-aware, observable, evidence-graded PR review with a TUI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pi-review": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "chalk": "5.6.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  }
}
